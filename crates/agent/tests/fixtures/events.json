    { "name": "claude unknown notification", "agent": "claude", "event": "Notification", "payload": { "notification_type": "auth_success" }, "expect": "ignored" },

    { "name": "codex startup", "agent": "codex", "event": "SessionStart", "payload": { "source": "startup" }, "expect": "running" },
    { "name": "codex prompt", "agent": "codex", "event": "UserPromptSubmit", "payload": {}, "expect": "running" },
    { "name": "codex permission", "agent": "codex", "event": "PermissionRequest", "payload": {}, "expect": "permission" },
    { "name": "codex pre-tool", "agent": "codex", "event": "PreToolUse", "payload": {}, "expect": "running" },
    { "name": "codex stop", "agent": "codex", "event": "Stop", "payload": {}, "expect": "done" },
    { "name": "codex interrupt", "agent": "codex", "event": "Interrupt", "payload": {}, "expect": "waiting" },
    { "name": "codex session end", "agent": "codex", "event": "SessionEnd", "payload": {}, "expect": "exited" },
