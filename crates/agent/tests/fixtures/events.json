    { "name": "pi compact failure", "agent": "pi", "event": "session_compact_failed", "payload": {}, "expect": "error" },
    { "name": "pi extension error", "agent": "pi", "event": "extension_error", "payload": {}, "expect": "error" },
    { "name": "pi shutdown", "agent": "pi", "event": "session_shutdown", "payload": {}, "expect": "exited" },
    { "name": "pi queue", "agent": "pi", "event": "queue_update", "payload": {}, "expect": "running" },

    { "name": "native alias fallback", "agent": "custom", "event": "custom.event", "native": "Stop", "payload": {}, "expect": "done" },
    { "name": "unknown event", "agent": "claude", "event": "SomethingNew", "payload": {}, "expect": "ignored" }
  ]
}
