    { "name": "codex subagent stop", "agent": "codex", "event": "SubagentStop", "payload": {}, "expect": "ignored" },

    { "name": "opencode busy", "agent": "opencode", "event": "session.status", "payload": { "type": "busy" }, "expect": "running" },
    { "name": "opencode retry", "agent": "opencode", "event": "session.status", "payload": { "type": "retry" }, "expect": "running" },
