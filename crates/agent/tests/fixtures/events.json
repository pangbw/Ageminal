{
  "cases": [
    { "name": "claude startup", "agent": "claude", "event": "SessionStart", "payload": { "source": "startup" }, "expect": "running" },
    { "name": "claude resume waits for prompt", "agent": "claude", "event": "SessionStart", "payload": { "source": "resume" }, "expect": "idle" },
    { "name": "claude prompt", "agent": "claude", "event": "UserPromptSubmit", "payload": {}, "expect": "running" },
    { "name": "claude pre-tool", "agent": "claude", "event": "PreToolUse", "payload": {}, "expect": "running" },
    { "name": "claude post-tool", "agent": "claude", "event": "PostToolUse", "payload": {}, "expect": "running" },
    { "name": "claude tool failure still activity", "agent": "claude", "event": "PostToolUseFailure", "payload": {}, "expect": "running" },
    { "name": "claude immediate permission", "agent": "claude", "event": "PermissionRequest", "payload": {}, "expect": "permission" },
    { "name": "claude permission notification", "agent": "claude", "event": "Notification", "payload": { "notification_type": "permission_prompt" }, "expect": "permission" },
    { "name": "claude needs input", "agent": "claude", "event": "Notification", "payload": { "notification_type": "agent_needs_input" }, "expect": "waiting" },
