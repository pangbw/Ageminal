    { "name": "claude background failure", "agent": "claude", "event": "Notification", "payload": { "notification_type": "agent_completed", "error": "boom" }, "expect": "error" },
    { "name": "claude stop", "agent": "claude", "event": "Stop", "payload": {}, "expect": "done" },
