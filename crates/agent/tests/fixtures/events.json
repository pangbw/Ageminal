    { "name": "opencode error", "agent": "opencode", "event": "session.error", "payload": { "error": "model failed" }, "expect": "error" },
    { "name": "opencode compacted", "agent": "opencode", "event": "session.compacted", "payload": {}, "expect": "running" },
    { "name": "opencode message activity", "agent": "opencode", "event": "message.updated", "payload": {}, "expect": "running" },
    { "name": "opencode file activity", "agent": "opencode", "event": "file.edited", "payload": {}, "expect": "running" },
    { "name": "opencode todo activity", "agent": "opencode", "event": "todo.updated", "payload": {}, "expect": "running" },
