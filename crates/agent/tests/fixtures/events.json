    { "name": "pi session start", "agent": "pi", "event": "session_start", "payload": {}, "expect": "running" },
    { "name": "pi before agent start", "agent": "pi", "event": "before_agent_start", "payload": {}, "expect": "running" },
    { "name": "pi agent start", "agent": "pi", "event": "agent_start", "payload": {}, "expect": "running" },
    { "name": "pi turn start", "agent": "pi", "event": "turn_start", "payload": {}, "expect": "running" },
    { "name": "pi message", "agent": "pi", "event": "message_update", "payload": {}, "expect": "running" },
    { "name": "pi tool", "agent": "pi", "event": "tool_execution_start", "payload": {}, "expect": "running" },
