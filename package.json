{
  "name": "ageminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ageminal — 面向个人开发者的 ADE（Agent Development Environment）",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm sidecars && tauri dev",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecars": "node scripts/build-sidecars.mjs",
    "bindings": "cargo run -p ageminal-desktop --features bindgen --bin export_bindings",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "check": "pnpm check:rust && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm check:licenses && pnpm check:bindings",
    "check:rust": "node scripts/check-rust.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:bindings": "node scripts/check-bindings.mjs",
    "build:e2e": "vue-tsc --noEmit && vite build --mode e2e",
    "e2e:build": "pnpm sidecars && pnpm tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e": "wdio run wdio.conf.js"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@tauri-apps/api": "^2.12.0",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/codicon": "^1.2.73",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tauri-apps/cli": "^2.12.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@wdio/cli": "9.31.9",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "webdriverio": "9.31.9"
  }
}
